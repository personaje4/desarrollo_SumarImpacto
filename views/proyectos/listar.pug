doctype html
html(lang="es")
  head
    link(rel="stylesheet" href="/formularios.css")
    meta(charset="UTF-8")
    title Proyectos - SumarImpacto
  body
    include ../_nav.pug

    - const formatearFecha = valor => valor ? new Date(valor).toLocaleDateString('es-AR', { timeZone: 'UTC', day: '2-digit', month: '2-digit', year: 'numeric' }) : ''

    h1 Listado de Proyectos Solidarios

    if esDonanteCorporativo
      p
        a(href='/donantes-corporativos') Volver a mis donaciones

    if usuario && usuario.rol === 'admin'
      p
        a(href="/proyecto/nuevo") + Registrar Nuevo Proyecto

    if proyectos && proyectos.length > 0
      table.listado-compacto(border="1")
        thead
          tr
            th ID MongoDB
            th Número
            th Nombre
            th Descripción
            th Organización
            th Responsable
            th Email Responsable
            th Fecha Inicio
            th Fecha Fin
            th Estado
            if usuario && usuario.rol === 'admin'
              th Acciones
        tbody
          each p in proyectos
            tr
              td= p._id
              td= p.idProyecto
              td= p.nombre
              td= p.descripcion
              td= p.organizacion
              td= p.responsable
              td= p.email_responsable
              td= formatearFecha(p.fechaInicio)
              td= formatearFecha(p.fechaFin)
              td= p.estado
              if usuario && usuario.rol === 'admin'
                td
                  a(href="/proyecto/" + p._id + "/editar") Editar
                  |  |
                  form(action="/proyecto/eliminar" method="POST" style="display:inline;" onsubmit="return confirm('¿Está seguro de que desea eliminar este proyecto?');")
                    input(type="hidden" name="idProyecto" value=p._id)
                    button(type="submit") Eliminar
    else
      p No hay proyectos registrados actualmente.

    if esAdministrador
      p
        a(href="/proyecto/eliminar") Eliminar por ID
