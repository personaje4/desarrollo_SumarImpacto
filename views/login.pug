doctype html
html(lang="es")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    title Iniciar Sesión - SumarImpacto
    style.
      body { font-family: system-ui, sans-serif; background-color: #f4f6f9; margin: 0; padding: 3rem 1rem; }
      .card { max-width: 400px; margin: 0 auto; background: white; padding: 2rem; border-radius: 8px; box-shadow: 0 4px 6px rgba(0,0,0,0.1); }
      .form-group { margin-bottom: 1.2rem; }
      label { display: block; margin-bottom: 0.4rem; font-weight: 600; color: #333; }
      input { width: 100%; padding: 0.6rem; border: 1px solid #ced4da; border-radius: 4px; box-sizing: border-box; }
      button { width: 100%; padding: 0.7rem; background-color: #0d6efd; color: white; border: none; border-radius: 4px; font-weight: bold; cursor: pointer; }
      button:hover { background-color: #0b5ed7; }
      .alert { padding: 0.75rem; background-color: #f8d7da; color: #842029; border: 1px solid #f5c2c7; border-radius: 4px; margin-bottom: 1rem; }
      .links { margin-top: 1.2rem; text-align: center; font-size: 0.9rem; }
  body
    .card
      h2(style="margin-top: 0; text-align: center;") SumarImpacto
      p(style="text-align: center; color: #6c757d; margin-bottom: 1.5rem;") Control de Acceso al Sistema

      if error
        .alert= error

      form(action="/login" method="POST")
        .form-group
          label(for="email") Correo Electrónico:
          input(type="email" id="email" name="email" required placeholder="admin@sumarimpacto.org")

        .form-group
          label(for="password") Contraseña:
          input(type="password" id="password" name="password" required placeholder="••••••••")

        button(type="submit") Ingresar

      .links
        p ¿No tenés usuario? 
          a(href="/registro") Crear una cuenta