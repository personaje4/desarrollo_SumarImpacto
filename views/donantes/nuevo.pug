doctype html
html(lang="es")
  head
    meta(charset="UTF-8")
    title Nuevo Donante - SumarImpacto
  body
    h1 Registrar Donante Corporativo
    form(action="/donanteCorporativo" method="POST")
      div
        label(for="razonSocial") Razón Social: 
        input(type="text" id="razonSocial" name="razonSocial" required)
      br
      div
        label(for="cuit") CUIT (11 dígitos): 
        input(type="text" id="cuit" name="cuit" maxlength="11" required)
      br
      div
        label(for="rubro") Rubro: 
        input(type="text" id="rubro" name="rubro")
      br
      div
        label(for="personaContacto") Persona de Contacto: 
        input(type="text" id="personaContacto" name="personaContacto" required)
      br
      div
        label(for="emailContacto") Email de Contacto: 
        input(type="email" id="emailContacto" name="emailContacto" required)
      br
      div
        label(for="montoTotalDonado") Monto Total Donado: 
        input(type="number" id="montoTotalDonado" name="montoTotalDonado" step="0.01")
      br
      div
        label(for="moneda") Moneda: 
        select(id="moneda" name="moneda")
          option(value="ARS" selected) ARS
          option(value="USD") USD
      br
      div
        label(for="proyectoAsignadoId") ID Proyecto Asignado: 
        input(type="text" id="proyectoAsignadoId" name="proyectoAsignadoId")
      br
      div
        label(for="estado") Estado: 
        select(id="estado" name="estado")
          option(value="activo" selected) Activo
          option(value="inactivo") Inactivo
      br
      div
        button(type="submit") Guardar Donante
    p
      a(href="/donanteCorporativo") Volver al listado