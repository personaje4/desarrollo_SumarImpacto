doctype html
html(lang='es')
  head
    meta(charset='UTF-8')
    title Donantes corporativos
  body
    h1 Donantes corporativos
    p
      a(href='/donanteCorporativo/nuevo') Registrar donante
    p
      a(href='/') Volver al inicio
    if donantes.length
      table(border='1' cellpadding='5')
        thead
          tr
            each titulo in ['ID MongoDB','ID histórico','Razón social','CUIT','Rubro','Contacto','Email','Monto','Moneda','Proyecto','Estado','Acciones']
              th= titulo
        tbody
          each d in donantes
            tr
              td= d._id
              td= d.idDonanteCorporativo || '—'
              td= d.razonSocial
              td= d.cuit
              td= d.rubro
              td= d.personaContacto
              td= d.emailContacto
              td= d.montoTotalDonado
              td= d.moneda
              td= d.proyectoAsignado ? d.proyectoAsignado.nombre : 'Sin proyecto'
              td= d.estado
              td
                a(href='/donanteCorporativo/' + d._id + '/editar') Editar
                form(action='/donanteCorporativo/eliminar' method='POST' onsubmit="return confirm('¿Está seguro de que desea eliminar este donante?');")
                  input(type='hidden' name='idDonante' value=d._id)
                  button(type='submit') Eliminar
    else
      p No hay donantes corporativos registrados.
