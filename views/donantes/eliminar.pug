doctype html
html(lang="es")
  head
    meta(charset="UTF-8")
    title Eliminar Donante Corporativo - SumarImpacto
  body
    h1 Eliminar un Donante Corporativo
    p
      a(href="/donanteCorporativo") ← Volver al Listado

    form(action="/donanteCorporativo/eliminar" method="POST" onsubmit="return confirm('¿Está seguro de que desea eliminar este donante?');")
      div
        label(for="idDonante") ID del Donante (Mongoose _id): 
        input(type="text" id="idDonante" name="idDonante" required placeholder="Ej: 64b8f...a1c")
      br
      button(type="submit") Eliminar Donante
