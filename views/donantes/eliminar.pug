doctype html
html(lang='es')
  head
    meta(charset='UTF-8')
    title Eliminar donante
  body
    h1 Eliminar donante corporativo
    form(action='/donanteCorporativo/eliminar' method='POST')
      label(for='idDonante') ObjectId o identificador histórico importado
      input(type='text' name='idDonante' id='idDonante' required)
      button(type='submit') Eliminar
    a(href='/donanteCorporativo') Volver al listado
