-
  const esAdministrador = usuario && usuario.rol === 'admin'
  const esDonanteCorporativo = usuario && usuario.rol === 'lector' && usuario.tieneDonanteVinculado

header(style="margin-bottom: 1.5rem; padding-bottom: 0.5rem; border-bottom: 1px solid #ccc;")
  nav(style="display: flex; justify-content: space-between; align-items: center;")
    div
      strong SumarImpacto
      |  |
      a(href="/") Inicio
      if esAdministrador
        |  |
        a(href="/proyecto") Proyectos
        |  |
        a(href="/donantes-corporativos") Donantes corporativos
      else if esDonanteCorporativo
        |  |
        a(href="/donantes-corporativos") Mis donaciones
    div
      if usuario
        span
          | Hola, #{usuario.nombre || 'Usuario'} ·
          if esAdministrador
            |  Administrador (rol: admin)
          else if esDonanteCorporativo
            |  Donante corporativo (rol: lector)
          else
            |  Rol: #{usuario.rol}
        form(action="/logout" method="POST" style="display: inline; margin-left: 10px;")
          button(type="submit") Cerrar sesión
      else
        a(href="/login") Iniciar sesión
