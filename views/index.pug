doctype html
html(lang="es")
  head
    meta(charset="UTF-8")
    title SumarImpacto - Inicio
  body
    h1 Sistema de Gestión SumarImpacto
    p ¡Bienvenido/a al sistema de gestión de proyectos y donantes!
    nav
      ul
        li
          a(href="/proyecto") Ver Proyectos
        li
          a(href="/donantes-corporativos") Ver Donantes Corporativos
    if usuario
      p Hola, #{usuario.nombre} (#{usuario.rol})
      form(method="POST" action="/logout")
        button(type="submit") Cerrar sesión
    else
      a(href="/login") Iniciar sesión