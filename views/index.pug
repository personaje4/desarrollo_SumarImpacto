doctype html
html(lang="es")
  head
    meta(charset="UTF-8")
    title SumarImpacto - Inicio
  body
    include _nav.pug

    h1 Sistema de Gestión SumarImpacto
    if esAdministrador
      p Gestioná los proyectos solidarios y los donantes corporativos.
      ul
        li
          a(href="/proyecto") Gestionar proyectos
        li
          a(href="/donantes-corporativos") Gestionar donantes corporativos
    else if esDonanteCorporativo
      p
        a(href="/donantes-corporativos") Ver mis donaciones
    else if usuario && usuario.rol === 'lector'
      p Tu cuenta todavía no está vinculada a un donante corporativo.
